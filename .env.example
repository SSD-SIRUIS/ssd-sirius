# ------------------------------------------------------------------
# SSD Sirius — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# Sans Supabase configuré, le site fonctionne avec des données de démo locales.
# ------------------------------------------------------------------

# URL publique du projet Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon publique Supabase (safe côté client, protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — SERVEUR UNIQUEMENT, ne jamais exposer au client.
# Utilisée par l'API interne pour insérer les leads en contournant le RLS si besoin.
SUPABASE_SERVICE_ROLE_KEY=

# URL canonique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://ssd-sirius.com

# Coordonnées publiques (fallback si la table settings est vide)
NEXT_PUBLIC_CONTACT_EMAIL=contact@sirius-mali.tech
NEXT_PUBLIC_CONTACT_PHONE=+33 6 98 43 36 02
NEXT_PUBLIC_CONTACT_PHONE_ALT=+33 7 51 41 90 26
NEXT_PUBLIC_CONTACT_WHATSAPP=33698433602

# ------------------------------------------------------------------
# Formspree — acheminement du formulaire de contact par e-mail.
# Créer un formulaire sur https://formspree.io, le configurer pour livrer à
# contact@sirius-mali.tech, puis coller ici l'endpoint complet.
# Tant que cette variable est vide, le formulaire retombe sur Supabase ; si
# Supabase est absent lui aussi, le formulaire renvoie une erreur explicite
# au visiteur au lieu d'un faux succès.
# Formspree doit autoriser les envois hors navigateur : la requête part du
# serveur Next.js, pas de la page. Désactiver la restriction par domaine,
# ou y ajouter le domaine de production.
# Laisser vide utilise l'endpoint par défaut codé dans src/app/api/leads/route.js.
# Ne renseigner ici que pour pointer vers un AUTRE formulaire (recette, etc.).
FORMSPREE_ENDPOINT=

# Adresse(s) recevant une copie de chaque demande, séparées par des virgules.
# Vide = aucune copie. Attention : ce champ `_cc` dépend du plan Formspree.
# Le réglage fiable reste la liste des destinataires dans le tableau de bord.
LEAD_NOTIFY_CC=

# Lien de réservation de rendez-vous (Google Agenda / Calendly).
# Vide = les boutons renvoient vers la page /contact.
NEXT_PUBLIC_BOOKING_URL=
