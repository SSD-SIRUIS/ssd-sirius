# ------------------------------------------------------------------
# SSD Sirius — variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs.
# Sans Supabase configuré, le site fonctionne avec des données de démo locales.
# ------------------------------------------------------------------

# URL publique du projet Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anon publique Supabase (safe côté client, protégée par RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase — SERVEUR UNIQUEMENT, ne jamais exposer au client.
# Utilisée par l'API interne pour insérer les leads en contournant le RLS si besoin.
SUPABASE_SERVICE_ROLE_KEY=

# URL canonique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://sirius-mali.tech

# Coordonnées publiques (fallback si la table settings est vide)
NEXT_PUBLIC_CONTACT_EMAIL=contact@sirius-mali.tech
NEXT_PUBLIC_CONTACT_PHONE=+33 6 98 43 36 02
NEXT_PUBLIC_CONTACT_PHONE_ALT=+33 7 51 41 90 26
NEXT_PUBLIC_CONTACT_WHATSAPP=33698433602

# Lien de réservation de rendez-vous (Google Agenda / Calendly).
# Vide = les boutons renvoient vers la page /contact.
NEXT_PUBLIC_BOOKING_URL=

# Acheminement du formulaire de contact (Formspree).
# L'identifiant n'est pas un secret : il figure en clair côté navigateur.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/mzezdroe

# Copie des notifications vers d'autres adresses, séparées par des virgules.
# Vide = aucune copie (le réglage fiable reste le tableau de bord Formspree).
LEAD_NOTIFY_CC=
